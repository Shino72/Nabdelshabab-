# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع ملف .env إلى أي مستودع عام.

# رابط الموقع النهائي (يُستخدم في الروابط الأساسية وخريطة الموقع وبيانات SEO)
SITE_URL=https://example.com
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# مفتاح سري عشوائي طويل (48 حرفًا أو أكثر). أنشئه بالأمر:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# اجعلها true عند التشغيل خلف Nginx أو Caddy لقراءة عنوان IP الحقيقي للزائر
TRUST_PROXY=true
# ملفات تعريف الارتباط الآمنة (تتطلب HTTPS). تُفعَّل تلقائيًا في وضع production
COOKIE_SECURE=true

# أماكن التخزين
DATA_DIR=data
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=5

# المنطقة الزمنية لعرض التواريخ والجدولة
TZ_NAME=Africa/Cairo

# إنشاء أول حساب مدير تلقائيًا عند أول تشغيل (احذف القيم بعد الإنشاء)
# أو استخدم الأمر: npm run create-admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# إضافة محتوى تجريبي عند إنشاء قاعدة بيانات جديدة (true/false)
SEED_DEMO=true
