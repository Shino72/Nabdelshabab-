# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع ملف .env إلى أي مستودع عام.
# على Vercel: لا تحتاج هذا الملف. اربط Supabase بالمشروع فتُضاف متغيرات قاعدة البيانات والتخزين تلقائيًا.

# قاعدة البيانات PostgreSQL (Supabase أو غيرها). على Vercel يكفي POSTGRES_URL الذي يضيفه ربط Supabase.
DATABASE_URL=
# اختياري: شهادة Supabase (من Project Settings > Database > SSL) للتحقق من هوية الخادم
DATABASE_CA_CERT=

# تخزين الصور في Supabase Storage (بدونها تُحفظ الصور في مجلد uploads على الخادم)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# رابط الموقع النهائي (يُستخدم في الروابط الأساسية وخريطة الموقع وبيانات SEO)
SITE_URL=https://example.com
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# مفتاح سري عشوائي طويل (48 حرفًا أو أكثر). إن لم يُضبط يُنشأ تلقائيًا ويُحفظ في قاعدة البيانات.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# اجعلها true عند التشغيل خلف Nginx أو Caddy لقراءة عنوان IP الحقيقي للزائر (تلقائية على Vercel)
TRUST_PROXY=true
# ملفات تعريف الارتباط الآمنة (تتطلب HTTPS). تُفعَّل تلقائيًا في وضع production
COOKIE_SECURE=true

# الصور عند التشغيل بدون Supabase Storage
UPLOADS_DIR=uploads
# الحد الأقصى لحجم الصورة (على Vercel: 4)
MAX_UPLOAD_MB=5

# المنطقة الزمنية لعرض التواريخ والجدولة
TZ_NAME=Africa/Cairo

# إنشاء أول حساب مدير تلقائيًا عند أول تشغيل (احذف كلمة المرور بعد الإنشاء)
# أو استخدم الأمر: npm run create-admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# إضافة محتوى تجريبي عند إنشاء قاعدة بيانات جديدة أو خالية من المواد (true/false)
SEED_DEMO=true

# كلمة مرور قاعدة PostgreSQL المحلية عند استخدام docker-compose (حروف وأرقام فقط)
POSTGRES_PASSWORD=
